# Copia este fichero como transfer.env (y dale permisos 600).
# Todas las variables son opcionales salvo que se indique lo contrario.

# Puerto HTTP de la aplicación
PORT=8080

# Base de datos SQLite y carpeta donde se guardan los ficheros subidos
DB_PATH=/opt/transfer/data/transfer.db
UPLOAD_DIR=/opt/transfer/uploads

# Usuario administrador que se crea en el primer arranque (si no existe).
# Si dejas INITIAL_ADMIN_PASS vacío, se genera una clave aleatoria y se
# escribe UNA sola vez en el log al arrancar. Cámbiala después desde
# "Administrar usuarios".
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASS=

# Días que se conservan los ficheros antes de borrarse automáticamente
RETENTION_DAYS=30

# Espacio total máximo que pueden ocupar los ficheros subidos (MB). 0 = sin límite
MAX_STORAGE_MB=10240

# Espacio libre mínimo que debe quedar en el disco tras una subida (MB)
MIN_FREE_DISK_MB=1024

# Tamaño máximo de cada subida
MAX_UPLOAD_SIZE=500MB

# Bloqueo de inicio de sesión: intentos fallidos permitidos por IP y minutos de bloqueo
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Token de la API de subida que usa el conector (mínimo 32 caracteres).
# Vacío = API desactivada
API_TOKEN=

# Pon true si la app se sirve por HTTPS (recomendado): la cookie de sesión
# solo viajará cifrada
SESSION_COOKIE_SECURE=true
